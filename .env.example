# ============================================
# Easy Blogger Backend — Environment Variables
# ============================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (NeonDB PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# JWT (optional, for refresh tokens)
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

OPENROUTER_API_KEY=your-openrouter-api-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_project_gmail@gmail.com
SMTP_PASS=your_16_char_app_password_here
SMTP_FROM=noreply@easyblogger.com

WORDPRESS_CLIENT_ID=your_app_client_id_from_developer_wordpress_com  
WORDPRESS_CLIENT_SECRET=your_app_client_secret
WORDPRESS_REDIRECT_URI=https://your-backend-domain.com/api/wordpress/callback