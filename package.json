{
  "name": "easy-blogger-backend",
  "version": "1.0.0",
  "description": "Backend API for Easy Blogger — a professional blogging platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "test": "jest --config=tests/jest.config.js",
    "test:watch": "jest --config=tests/jest.config.js --watch",
    "test:coverage": "jest --config=tests/jest.config.js --coverage",
    "test:verbose": "jest --config=tests/jest.config.js --verbose"
  },
  "keywords": [
    "blog",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.11",
    "openai": "^6.22.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "stripe": "^22.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1",
    "tsx": "^4.21.0"
  }
}
