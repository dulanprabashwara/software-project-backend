generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  firebaseUid        String            @unique
  email              String            @unique
  username           String            @unique
  displayName        String?
  bio                String?
  avatarUrl          String?
  role               Role              @default(USER)
  isPremium          Boolean           @default(false)
  stripeCustomerId   String?           @unique
  linkedInAccountId  String?
  wordpressAccountId String?
  isOnline           Boolean           @default(false)
  lastSeen           DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  stripeCustomerId   String?           @unique
  ai_article_logs    ai_article_logs[]
  likes              ArticleLike[]
  shares             ArticleShare[]
  articles           Article[]
  auditLogs          AuditLog[]
  bansIssued         BannedUser[]      @relation("BannedBy")
  bannedRecord       BannedUser?       @relation("BannedUser")
  comments           Comment[]
  following          Follow[]          @relation("Followers")
  followers          Follow[]          @relation("Following")
  receivedMessages   Message[]         @relation("ReceivedMessages")
  sentMessages       Message[]         @relation("SentMessages")
  notifications      Notification[]
  readHistory        ReadHistory[]
  reportedArticles   ReportedArticle[] @relation("Reporter")
  savedArticles      SavedArticle[]
  stories            Story[]
  subscriptions      subscriptions[]
  stats              UserStats?
  subscriptions      Subscription[]

  @@map("users")
}

model Article {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  content         String
  summary         String?
  coverImage      String?
  status          ArticleStatus     @default(DRAFT)
  isAiGenerated   Boolean           @default(false)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  readCount       Int               @default(0)
  likeCount       Int               @default(0)
  shareCount      Int               @default(0)
  commentCount    Int               @default(0)
  tags            String[]
  readingTime     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  authorId        String
  ai_article_logs ai_article_logs?
  likes           ArticleLike[]
  shares          ArticleShare[]
  author          User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments        Comment[]
  readHistory     ReadHistory[]
  reports         ReportedArticle[]
  savedBy         SavedArticle[]

  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@index([slug])
  @@map("articles")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parentId  String?
  authorId  String
  articleId String
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([articleId])
  @@index([authorId])
  @@map("comments")
}

model ArticleLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@map("article_likes")
}

model ArticleShare {
  id        String   @id @default(cuid())
  platform  String?
  createdAt DateTime @default(now())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_shares")
}

model SavedArticle {
  id        String   @id @default(cuid())
  savedAt   DateTime @default(now())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("saved_articles")
}

model ReadHistory {
  id         String   @id @default(cuid())
  lastReadAt DateTime @default(now())
  readCount  Int      @default(1)
  userId     String
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("read_history")
}

model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  followerId  String
  followingId String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Story {
  id        String   @id @default(cuid())
  mediaUrl  String
  caption   String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([expiresAt])
  @@map("stories")
}

model Message {
  id         String   @id @default(cuid())
  content    String
  isRead     Boolean  @default(false)
  sentAt     DateTime @default(now())
  senderId   String
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([sentAt])
  @@map("messages")
}

model UserStats {
  id             String   @id @default(cuid())
  totalReads     Int      @default(0)
  totalLikes     Int      @default(0)
  totalFollowers Int      @default(0)
  totalFollowing Int      @default(0)
  articleCount   Int      @default(0)
  updatedAt      DateTime @updatedAt
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  userId    String
  actorId   String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model ReportedArticle {
  id         String       @id @default(cuid())
  reason     String
  status     ReportStatus @default(PENDING)
  details    String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  articleId  String
  reporterId String
  article    Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reported_articles")
}

model BannedUser {
  id          String    @id @default(cuid())
  reason      String
  bannedAt    DateTime  @default(now())
  bannedUntil DateTime?
  userId      String    @unique
  bannedById  String
  bannedBy    User      @relation("BannedBy", fields: [bannedById], references: [id])
  user        User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("banned_users")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetId   String?
  targetType String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminDashboard {
  id             String   @id @default("singleton")
  totalUsers     Int      @default(0)
  totalArticles  Int      @default(0)
  totalRevenue   Float    @default(0)
  activeSessions Int      @default(0)
  premiumUsers   Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("admin_dashboard")
}

model AiConfig {
  id            String   @id @default("singleton")
  modelName     String   @default("gpt-4")
  apiUsageLimit Int      @default(1000)
  currentUsage  Int      @default(0)
  isEnabled     Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("ai_config")
}

model TrendingTopic {
  id        String   @id @default(cuid())
  name      String   @unique
  hitCount  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([hitCount])
  @@map("trending_topics")
}

model Offer {
  id               String         @id @default(cuid())
  name             String
  discount_percent Int
  stripe_coupon_id String?
  is_active        Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  features         Json?

  subscriptions    Subscription[]

  @@map("offers")
}

// ─── Subscription ───────────────────

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  offerId                String?
  stripeSubscriptionId   String    @unique
  stripeCurrentPeriodEnd DateTime?
  status                 String    @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  offer Offer? @relation(fields: [offerId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model ai_article_logs {
  id                String   @id
  userPrompt        String
  keywordsPresented String[]
  keywordsSelected  String[]
  articleLength     String?
  tone              String?
  articleTitle      String
  articleContent    String
  wordCount         Int
  savedToDraftId    String?  @unique
  generatedAt       DateTime @default(now())
  authorId          String
  users             User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  articles          Article? @relation(fields: [savedToDraftId], references: [id])

  @@index([authorId])
  @@index([generatedAt])
}

model ScrapingSource {
  id               String   @id @default(cuid())
  name             String
  url              String   @unique
  category         String
  scrapeWindow     String   @default("Last 7 Days")
  minWordCount     Int      @default(300)
  excludedKeywords String[]
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("scraping_sources")
}

model subscriptions {
  id                     String    @id
  userId                 String
  offerId                String?
  stripeSubscriptionId   String    @unique
  stripeCurrentPeriodEnd DateTime?
  status                 String    @default("active")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime
  offers                 Offer?    @relation(fields: [offerId], references: [id])
  users                  User      @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}
// ─── ScrapingSession ─────────────────────────────────────────────
// One row per weekly scraping run.
// Created at Phase 1 start. Updated at Phase 3 end.

model ScrapingSession {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  status         String    @default("running") // "running" | "completed" | "failed"
  lastScrapeDate DateTime?

  // Phase 2 counters (raw scraping results)
  totalSources   Int   @default(0)
  totalUrlsFound Int   @default(0)
  successCount   Int   @default(0)
  duplicateCount Int   @default(0)
  failureCount   Int   @default(0)

  // Phase 3 enrichment results
  enrichedCount         Int   @default(0)  // articles successfully summarized + tagged
  enrichmentFailedCount Int   @default(0)  // articles that failed AI enrichment
  keywordsCoveredCount  Int   @default(0)  // how many of the 400 keywords got at least 1 article
  keywordsEmptyCount    Int   @default(0)  // keywords with no articles this session

  // Token tracking for enrichment AI calls (for report)
  aiInputTokens  Int   @default(0)
  aiOutputTokens Int   @default(0)

  // Phase 3 report data
  successRate     Float?
  durationMinutes Float?
  reportData      String?   // full JSON report as string
  reportSentAt    DateTime?
  criticalErrors  Boolean   @default(false)

  logs            ScrapingLog[]
  keywordStats    KeywordScrapingStats[]
  scrapedArticles ScrapedArticle[]

  @@index([startedAt])
  @@index([status])
  @@map("scraping_sessions")
}


// ─── ScrapingLog ─────────────────────────────────────────────────
// One row per event during scraping.
// Every HTTP error, validation failure, duplicate, and success
// gets its own log row linked to the parent session.

model ScrapingLog {
  id        String   @id @default(cuid())
  sessionId String

  // logType values match diagram branch outcomes:
  // "success"            → article saved
  // "duplicate"          → already in DB
  // "http_error"         → request failed (4xx/5xx/timeout)
  // "validation_failure" → content invalid (too short, too old, excluded keyword)
  // "enrichment_success" → AI summarization succeeded
  // "enrichment_failure" → AI summarization failed
  // "info"               → general session status messages
  logType    String

  url        String
  category   String?
  statusCode Int?
  reason     String?
  details    Json?
  loggedAt   DateTime @default(now())

  session ScrapingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([logType])
  @@map("scraping_logs")
}


// ─── ScrapedArticle ──────────────────────────────────────────────
// Stores every successfully scraped article.
// NOT linked to any User — platform-wide content table.
// After Phase 2: has raw content but no summary/matchedKeywords.
// After Phase 3 enrichment: has summary + matchedKeywords populated.

model ScrapedArticle {
  id               String    @id @default(cuid())
  sourceUrl        String    @unique  // @unique prevents duplicates at DB level
  title            String
  content          String              // cleaned text (headings + paragraphs only)
  author           String?
  publishedDate    DateTime?
  wordCount        Int
  category         String              // broad category = ScrapingSource.category
  scrapingSourceId String              // ScrapingSource.id (stored as plain string, no FK constraint)
  metadata         Json?               // og:description, siteName, pageTitle

  // Populated by Phase 3 AI enrichment
  summary         String?   // 130-150 word AI-generated summary
  matchedKeywords String[]  // specific keywords from the 400-keyword list

  scrapedAt DateTime @default(now())
  sessionId String

  session ScrapingSession @relation(fields: [sessionId], references: [id])

  @@index([category])
  @@index([scrapedAt])
  @@index([sessionId])
  @@index([scrapingSourceId])
  @@map("scraped_articles")
}


// ─── KeywordScrapingStats ─────────────────────────────────────────
// Per-category statistics for each session.
// Saved after all URLs for a category are scraped (Phase 2).
// Updated after enrichment to show keyword-level coverage (Phase 3).

model KeywordScrapingStats {
  id             String @id @default(cuid())
  sessionId      String
  category       String  // broad category (Technology/Health/Finance/Lifestyle)
  urlsProcessed  Int     @default(0)
  successCount   Int     @default(0)
  duplicateCount Int     @default(0)
  failureCount   Int     @default(0)

  session ScrapingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("keyword_scraping_stats")
}
enum Role {
  USER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MENTION
  SYSTEM
  NEW_ARTICLE
}

