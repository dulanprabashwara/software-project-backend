generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// @description
/// The `firebaseUid` field serves as the secure, immutable bridge between Firebase Auth 
/// (which handles passwords/JWTs) and our Postgres database (which handles roles and data).
model User {
  id                     String                @id @default(cuid())
  firebaseUid            String                @unique
  email                  String                @unique
  username               String                @unique
  displayName            String?
  bio                    String?
  avatarUrl              String?
  role                   Role                  @default(USER)
  isPremium              Boolean               @default(false)
  linkedInAccountId      String?
  wordpressAccountId     String?
  isOnline               Boolean               @default(false)
  lastSeen               DateTime              @default(now())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  stripeCustomerId       String?               @unique
  ai_article_logs        ai_article_logs[]
  interactedArticles     ArticleInteractions[]
  rating                 ArticleRating[]
  shares                 ArticleShare[]
  articles               Article[]
  auditLogs              AuditLog[]
  bansIssued             BannedUser[]          @relation("BannedBy")
  bannedRecord           BannedUser?           @relation("BannedUser")
  comments               Comment[]
  following              Follow[]              @relation("Followers")
  followers              Follow[]              @relation("Following")
  linkedinConnections    LinkedInConnection[]
  liPublishJobs          LinkedInPublishJob[]
  receivedMessages       Message[]             @relation("ReceivedMessages")
  sentMessages           Message[]             @relation("SentMessages")
  notifications          Notification[]        @relation("NotificationDest")
  notificationsTriggered Notification[]        @relation("NotificationSource")
  readHistory            ReadHistory[]
  reportedArticles       ReportedArticle[]     @relation("Reporter")
  savedArticles          SavedArticle[]
  stories                Story[]
  subscriptions          Subscription[]
  stats                  UserStats?
  wordpressConnection    WordPressConnection?
  wpPublishJobs          WordPressPublishJob[]
  sessions               UserSession[]

  @@map("users")
}

model Article {
  id                      String                @id @default(cuid())
  title                   String
  slug                    String                @unique
  content                 String
  summary                 String?
  coverImage              String?
  status                  ArticleStatus         @default(DRAFT)
  isAiGenerated           Boolean               @default(false)
  scheduledAt             DateTime?
  publishedAt             DateTime?
  readCount               Int                   @default(0)
  averageRating           Float                 @default(0.0)
  ratingCount             Int                   @default(0)
  shareCount              Int                   @default(0)
  commentCount            Int                   @default(0)
  tags                    String[]
  readingTime             Int                   @default(0)
  createdAt               DateTime              @default(now())
  trendingScore           Float                 @default(0.0)
  updatedAt               DateTime              @default(now())
  authorId                String
  editingBackupContent    String?
  editingBackupCoverImage String?
  editingBackupTitle      String?
  editingStartedAt        DateTime?
  isEdited                Boolean               @default(false)
  isEditAsNew             Boolean               @default(false)
  sourceArticleId         String?
  ai_article_logs         ai_article_logs?
  interactions            ArticleInteractions[]
  ratings                 ArticleRating[]
  shares                  ArticleShare[]
  author                  User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments                Comment[]
  liPublishJobs           LinkedInPublishJob[]
  notifications           Notification[]
  readHistory             ReadHistory[]
  reports                 ReportedArticle[]
  savedBy                 SavedArticle[]
  wpPublishJobs           WordPressPublishJob[]

  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@index([slug])
  @@index([sourceArticleId])
  @@map("articles")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parentId  String?
  authorId  String
  articleId String
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([articleId])
  @@index([authorId])
  @@map("comments")
}

model ArticleRating {
  id        String   @id @default(cuid())
  score     Int      @default(0)
  createdAt DateTime @default(now())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@map("article_ratings")
}

model ArticleShare {
  id        String   @id @default(cuid())
  platform  String?
  createdAt DateTime @default(now())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_shares")
}

model SavedArticle {
  id        String   @id @default(cuid())
  savedAt   DateTime @default(now())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("saved_articles")
}

model ReadHistory {
  id         String   @id @default(cuid())
  lastReadAt DateTime @default(now())
  readCount  Int      @default(1)
  userId     String
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("read_history")
}

model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  followerId  String
  followingId String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Story {
  id        String   @id @default(cuid())
  mediaUrl  String
  caption   String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([expiresAt])
  @@map("stories")
}

model Message {
  id         String   @id @default(cuid())
  content    String
  isRead     Boolean  @default(false)
  sentAt     DateTime @default(now())
  senderId   String
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([sentAt])
  @@index([senderId, receiverId, sentAt])
  @@index([receiverId, isRead])
  @@map("messages")
}

model UserStats {
  id             String   @id @default(cuid())
  totalReads     Int      @default(0)
  averageRating  Float    @default(0.0)
  totalFollowers Int      @default(0)
  totalFollowing Int      @default(0)
  articleCount   Int      @default(0)
  updatedAt      DateTime @updatedAt
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  sourceUserId    String?
  sourceArticleId String?
  destUserId      String
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  destUser        User             @relation("NotificationDest", fields: [destUserId], references: [id], onDelete: Cascade)
  sourceArticle   Article?         @relation(fields: [sourceArticleId], references: [id], onDelete: Cascade)
  sourceUser      User?            @relation("NotificationSource", fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@index([destUserId])
  @@index([createdAt])
  @@map("notifications")
}

model ReportedArticle {
  id         String       @id @default(cuid())
  reason     String
  status     ReportStatus @default(PENDING)
  details    String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  articleId  String
  reporterId String
  article    Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reported_articles")
}

model BannedUser {
  id          String    @id @default(cuid())
  reason      String
  bannedAt    DateTime  @default(now())
  bannedUntil DateTime?
  userId      String    @unique
  bannedById  String
  bannedBy    User      @relation("BannedBy", fields: [bannedById], references: [id])
  user        User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("banned_users")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetId   String?
  targetType String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminDashboard {
  id             String   @id @default("singleton")
  totalUsers     Int      @default(0)
  totalArticles  Int      @default(0)
  totalRevenue   Float    @default(0)
  activeSessions Int      @default(0)
  premiumUsers   Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("admin_dashboard")
}

model AiConfig {
  id            String   @id @default("singleton")
  modelName     String   @default("gpt-4")
  apiUsageLimit Int      @default(1000)
  currentUsage  Int      @default(0)
  isEnabled     Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("ai_config")
}

model TrendingTopic {
  id        String   @id @default(cuid())
  name      String   @unique
  hitCount  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([hitCount])
  @@map("trending_topics")
}

model Offer {
  id               String         @id @default(cuid())
  name             String
  discount_percent Int
  stripe_coupon_id String?
  is_active        Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]

  @@map("offers")
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  offerId                String?
  stripeSubscriptionId   String    @unique
  stripeCurrentPeriodEnd DateTime?
  status                 String    @default("active")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  offer                  Offer?    @relation(fields: [offerId], references: [id])
  user                   User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model ai_article_logs {
  id                String    @id @default(cuid())
  userPrompt        String
  keywordsPresented String[]
  keywordsSelected  String[]
  articleLength     String?
  tone              String?
  articleTitle      String
  articleContent    String
  wordCount         Int
  linkedArticleId   String?   @unique @map("savedToDraftId")
  generatedAt       DateTime  @default(now())
  authorId          String
  aiInputTokens     Int       @default(0)
  aiOutputTokens    Int       @default(0)
  deletedAt         DateTime?
  userResponse      String?
  users             User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  articles          Article?  @relation(fields: [linkedArticleId], references: [id])

  @@index([authorId])
  @@index([generatedAt])
  @@index([deletedAt])
}

model ScrapingSource {
  id               String   @id @default(cuid())
  name             String
  url              String   @unique
  category         String
  scrapeWindow     String   @default("Last 7 Days")
  minWordCount     Int      @default(300)
  excludedKeywords String[]
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("scraping_sources")
}

model ScrapingSession {
  id                    String                  @id @default(cuid())
  startedAt             DateTime                @default(now())
  completedAt           DateTime?
  status                String                  @default("running")
  lastScrapeDate        DateTime?
  totalSources          Int                     @default(0)
  totalUrlsFound        Int                     @default(0)
  successCount          Int                     @default(0)
  duplicateCount        Int                     @default(0)
  failureCount          Int                     @default(0)
  enrichedCount         Int                     @default(0)
  enrichmentFailedCount Int                     @default(0)
  keywordsCoveredCount  Int                     @default(0)
  keywordsEmptyCount    Int                     @default(0)
  aiInputTokens         Int                     @default(0)
  aiOutputTokens        Int                     @default(0)
  successRate           Float?
  durationMinutes       Float?
  reportData            String?
  reportSentAt          DateTime?
  criticalErrors        Boolean                 @default(false)
  categoryStats         CategoryScrapingStats[]
  scrapedArticles       ScrapedArticle[]
  logs                  ScrapingLog[]

  @@index([startedAt])
  @@index([status])
  @@map("scraping_sessions")
}

model ScrapingLog {
  id         String          @id @default(cuid())
  sessionId  String
  logType    String
  url        String
  category   String?
  statusCode Int?
  reason     String?
  details    Json?
  loggedAt   DateTime        @default(now())
  session    ScrapingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([logType])
  @@map("scraping_logs")
}

model ScrapedArticle {
  id               String          @id @default(cuid())
  sourceUrl        String          @unique
  title            String
  content          String
  author           String?
  publishedDate    DateTime?
  wordCount        Int
  category         String
  scrapingSourceId String
  metadata         Json?
  summary          String?
  matchedKeywords  String[]
  scrapedAt        DateTime        @default(now())
  sessionId        String
  session          ScrapingSession @relation(fields: [sessionId], references: [id])

  @@index([category])
  @@index([scrapedAt])
  @@index([sessionId])
  @@index([scrapingSourceId])
  @@map("scraped_articles")
}

model CategoryScrapingStats {
  id             String          @id @default(cuid())
  sessionId      String
  category       String
  urlsProcessed  Int             @default(0)
  successCount   Int             @default(0)
  duplicateCount Int             @default(0)
  failureCount   Int             @default(0)
  createdAt      DateTime        @default(now())
  session        ScrapingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, category])
  @@map("keyword_scraping_stats")
}

model WordPressConnection {
  id               String                @id @default(cuid())
  userId           String                @unique
  siteUrl          String
  siteId           String
  accessToken      String
  wpUsername       String?
  wpProfilePicture String?
  wpEmail          String?
  connectedAt      DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobs      WordPressPublishJob[]

  @@map("wordpress_connections")
}

model WordPressPublishJob {
  id           String              @id @default(cuid())
  articleId    String
  userId       String
  wpConnId     String
  scheduledAt  DateTime
  status       WpJobStatus         @default(PENDING)
  wpPostId     String?
  wpPostUrl    String?
  draftUrl     String?
  errorMsg     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  article      Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  wpConnection WordPressConnection @relation(fields: [wpConnId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledAt])
  @@map("wordpress_publish_jobs")
}

model ArticleInteractions {
  id            String   @id @default(cuid())
  userId        String
  articleId     String
  commentStatus Boolean  @default(false)
  rateStatus    Boolean  @default(false)
  createdAt     DateTime @default(now())
  dateUpdated   DateTime @updatedAt
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([dateUpdated])
  @@map("article_interactions")
}


enum Role {
  USER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  EDITING
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  RATE
  FOLLOW
  COMMENT
  NEW_ARTICLE
  LINKEDIN_SHARE
  WORDPRESS_SHARE
}

enum WpJobStatus {
  PENDING
  IN_PROGRESS
  PUBLISHED
  FAILED
  CANCELLED
}

model LinkedInConnection {
  id               String               @id @default(cuid())
  userId           String
  accessToken      String
  liMemberId       String               @unique
  liDisplayName    String?
  liProfilePicture String?
  isActive         Boolean              @default(true)
  connectedAt      DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobs      LinkedInPublishJob[]

  @@index([userId])
  @@map("linkedin_connections")
}

model LinkedInPublishJob {
  id           String             @id @default(cuid())
  articleId    String
  userId       String
  liConnId     String?
  scheduledAt  DateTime
  status       WpJobStatus        @default(PENDING)
  liPostId     String?
  liPostUrl    String?
  title        String?            // Snapshot of article title at scheduling time
  coverImage   String?            // Snapshot of article cover image at scheduling time
  caption      String?
  errorMsg     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  article      Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  liConnection LinkedInConnection? @relation(fields: [liConnId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([scheduledAt])
  @@map("linkedin_publish_jobs")
}

model UserSession {
  id          String   @id @default(cuid())
  deviceInfo  String   // "Chrome on Windows"
  ipAddress   String?  // "124.43.15.2"
  status      String   @default("ACTIVE") // ACTIVE or REVOKED
  lastActive  DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("user_sessions")
}

model SupportRequest {
  id        String   @id @default(cuid())
  email     String
  problem   String

  // --- Admin Tracking Fields ---
  status    String   @default("PENDING") // Options: PENDING, IN_PROGRESS, RESOLVED
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("support_requests")
}

model PlatformEvent {
  id        String   @id @default(cuid())
  type      String   // e.g., "USER_SIGNUP", "PREMIUM_UPGRADE", "ARTICLE_PUBLISHED", "TICKET_CREATED"
  message   String   // e.g., "Emma upgraded to Premium"
  linkUrl   String?  // Optional: A URL to redirect the admin to when they click the feed item
  createdAt DateTime @default(now())

  @@index([createdAt])
}